# Frontend (.env.local). `npx convex dev` writes NEXT_PUBLIC_CONVEX_URL for you.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_ORG_NAME=Acme
NEXT_PUBLIC_SITE_URL=http://localhost:3016
# Optional: a logo in /public or a full URL, and a link to your own help docs.
NEXT_PUBLIC_LOGO_URL=
NEXT_PUBLIC_HELP_CENTER_URL=

# Backend: set these on the Convex deployment with `npx convex env set NAME value`.
# SUPERADMIN_EMAILS=you@acme.com
# OWNER_EMAILS=you@acme.com
# SITE_URL=http://localhost:3016
# APP_URL=http://localhost:3016
# APP_NAME=Acme Time Off
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# RESEND_API_KEY=            optional; without it, email is skipped
# LEAVE_FROM_EMAIL="Acme Time Off <timeoff@acme.com>"
# DEMO_MODE=true             only for a public demo: anonymous sign-in and a nightly reset
